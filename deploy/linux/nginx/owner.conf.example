# Standalone application-host example. Requires existing reviewed certificate paths.
# Do not replace the current 2GB ingress site's reverse-tunnel configuration with it.
server {
    listen 80;
    server_name h5.jiaanfuwu.cn wx.jiaanfuwu.cn admin.jiaanfuwu.cn;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/wuye/acme;
        try_files $uri =404;
    }
    location ~ ^/MP_verify_[A-Za-z0-9]+\.txt$ {
        root /var/www/wuye/verify;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name h5.jiaanfuwu.cn;
    ssl_certificate /etc/letsencrypt/live/wuye-ingress/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wuye-ingress/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/wuye-error.log crit;
    client_max_body_size 256k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location ~ ^/MP_verify_[A-Za-z0-9]+\.txt$ {
        root /var/www/wuye/verify;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host h5.jiaanfuwu.cn;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host h5.jiaanfuwu.cn;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
}

server {
    listen 443 ssl;
    server_name wx.jiaanfuwu.cn;
    ssl_certificate /etc/letsencrypt/live/wuye-ingress/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wuye-ingress/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/wuye-error.log crit;
    client_max_body_size 256k;
    location ~ ^/MP_verify_[A-Za-z0-9]+\.txt$ {
        root /var/www/wuye/verify;
        default_type text/plain;
        try_files $uri =404;
    }
    location = /wechat/callback {
        proxy_pass http://127.0.0.1:8080/wechat-test/callback;
        proxy_set_header Host h5.jiaanfuwu.cn;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host h5.jiaanfuwu.cn;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location / { return 404; }
}

server {
    listen 443 ssl;
    server_name admin.jiaanfuwu.cn;
    ssl_certificate /etc/letsencrypt/live/wuye-ingress/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wuye-ingress/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    location / { return 403; }
}
