[Unit]
Description=Wuye non-payment Node service %i
Wants=network-online.target
After=network-online.target
PartOf=wuye-nonpayment.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=wuye
Group=wuye
WorkingDirectory=/var/lib/wuye
Environment=WUYE_CONFIG_DIR=/etc/wuye
Environment=NODE_ENV=production
Environment=NODE_PATH=/opt/wuye/deps/node_modules
Environment=BACKEND_URL=http://127.0.0.1:8012
Environment=TZ=Asia/Shanghai
ExecStartPre=/usr/bin/test -f /etc/wuye/READY_FOR_NONPAYMENT
ExecStart=/usr/bin/node /opt/wuye/current/linux/bin/%i.cjs
Restart=on-failure
RestartSec=20
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wuye /var/log/wuye
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=wuye-nonpayment.target
